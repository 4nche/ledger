# Copy to .env and adjust. .env is gitignored.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=journal
POSTGRES_PASSWORD=journal
POSTGRES_DB=trading_journal
POSTGRES_PORT=5432

# --- Application ---
DATABASE_URL=postgresql://journal:journal@localhost:5432/trading_journal

API_PORT=4000
WEB_PORT=3000

# Default timezone used for day/week/month reporting buckets.
# Storage is always UTC; this only affects how periods are cut.
REPORTING_TIMEZONE=Europe/Amsterdam

# Base URL the web app uses to reach the API (server-side).
API_BASE_URL=http://localhost:4000

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google addresses permitted to sign in. Signing in with Google
# proves identity, not authorisation — this list is what keeps people out.
# An empty value denies everyone rather than admitting everyone.
ALLOWED_EMAILS=
